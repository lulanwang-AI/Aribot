{
  "expo": {
    "name": "ARIbots Mobile",
    "slug": "aribots-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aribots-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aribots.mobile"
    },
    "android": {
      "package": "com.aribots.mobile"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow ARIbots to use the camera to photograph wounds, rashes, and printed scans to ask Ari about them.",
          "photosPermission": "Allow ARIbots to access your photos so you can attach images to your questions for Ari."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
